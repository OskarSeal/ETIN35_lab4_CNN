# Make a reference netlist (IPs/*/behav_vhdl/*.vhd) usable as a submodule in synthesis.
# The course netlists were written by write_vhdl from each block synthesized as a top level, so
#   - each top entity carries "attribute NotValidForBitStream ... is true", which Vivado
#     synthesis rejects (Synth 8-5832, "source file was generated for simulation"), and
#   - every port goes through an IBUF / OBUF (the clock through IBUF + BUFG), which cannot sit
#     on internal nets of the whole design.
# synth_netlist drops the attribute and replaces each IBUF / OBUF / BUFG instance by the
# assignment O <= I; the rest (LUTs, FDCEs, CARRY4s, ...) stays as it is. The copy behaves the
# same in simulation.
#
#   synth_netlist <netlist> <out_dir>   writes <out_dir>/<netlist file name>, returns its path

proc synth_netlist {src out_dir} {
    set fh [open $src r]; set text [read $fh]; close $fh

    set n_attr [regsub -all -line {^\s*attribute NotValidForBitStream\M.*$\n} $text {} text]
    set buf {(\S+): unisim\.vcomponents\.(?:IBUF|OBUF|BUFG)\s+port map \(\s*I => ([^,\s]+),\s*O => (\S+)\s*\);}
    set n_buf [regsub -all $buf $text {\3 <= \2;} text]
    if {$n_attr == 0 || [regexp {vcomponents\.(IBUF|OBUF|BUFG)\M} $text]} {
        error "synth_netlist: unexpected netlist format in $src"
    }

    file mkdir $out_dir
    set dst [file join $out_dir [file tail $src]]
    set fh [open $dst w]
    puts -nonewline $fh "-- Generated by vivado/synth_netlist.tcl from [file tail $src]:\
        NotValidForBitStream removed, $n_buf I/O and clock buffers replaced by assignments.\n$text"
    close $fh
    return $dst
}
